{
  "name": "NETFLIC Local Dashboard",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bullseye",
  "postCreateCommand": "npm run install:all",
  "forwardPorts": [4000, 5173],
  "portsAttributes": {
    "5173": {
      "label": "Frontend",
      "onAutoForward": "openBrowser"
    },
    "4000": {
      "label": "Backend API"
    }
  }
}
